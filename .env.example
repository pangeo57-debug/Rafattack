# Database (Postgres). On Vercel, use the Storage tab -> Postgres (Neon)
# integration and it will set this for you. Locally, use a free Neon/Supabase
# project or a local Postgres instance.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (Connect + Checkout). Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (Resend). Get a key from https://resend.com/api-keys — without one,
# verification/reset emails are just logged to the server console, which is
# fine for local dev but means real users can't verify/reset in production.
RESEND_API_KEY=""
EMAIL_FROM="Surplo <onboarding@resend.dev>"

# Platform
PLATFORM_COMMISSION_PERCENT="8"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required on any host other than Vercel (Netlify, local `next start`), or
# login fails with "UntrustedHost".
AUTH_TRUST_HOST="true"

# Protects /api/cron/order-timers (hourly order deadlines). Any long random
# string, e.g. `openssl rand -hex 32`. Without it the timers refuse to run.
CRON_SECRET=""
